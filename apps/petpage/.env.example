# Firebase App Check starts in monitor mode. Switch to enforce only after validating metrics.
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=
APP_CHECK_ENFORCEMENT=monitor

# Firebase Admin credentials (never expose these values in NEXT_PUBLIC_* variables).
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Required to send appointment confirmations from the scheduling screen.
APPOINTMENT_EMAIL_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
